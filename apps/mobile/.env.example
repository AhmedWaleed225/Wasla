# Copy to apps/mobile/.env
# The API address as seen from the phone or emulator:
#   iOS simulator / web:   http://localhost:4000/v1
#   Android emulator:      http://10.0.2.2:4000/v1
#   Physical phone (Expo Go on the same Wi-Fi): http://<your-computer-LAN-IP>:4000/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
