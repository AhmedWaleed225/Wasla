# Copy to apps/mobile/.env
# The API address as seen from the phone or emulator:
#   iOS simulator / web:   http://localhost:4000/v1
#   Android emulator:      http://10.0.2.2:4000/v1
#   Physical phone (Expo Go on the same Wi-Fi): http://<your-computer-LAN-IP>:4000/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/v1

# ===========================================================================
# PLACEHOLDERS — fill in when you have accounts. Not read by the app yet.
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone who
# installs it: only put keys here that are restricted to the app's bundle id.
# ===========================================================================

# Expo / EAS project id (https://expo.dev) — needed for push notification tokens.
EAS_PROJECT_ID=

# Google Maps SDK key for the in-app map, restricted to app.wasla.mobile.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
