# Copy to apps/api/.env for local development. Never commit real values.

NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS (admin dashboard, Expo web).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Matches docker-compose.yml (local only)
DATABASE_URL=postgresql://wasla:wasla_local_dev@localhost:5432/wasla?schema=public
REDIS_URL=redis://localhost:6379

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
OTP_HASH_SECRET=replace-with-a-different-long-random-string

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# OTP delivery. "mock" prints codes to the API log and is refused when NODE_ENV=production.
OTP_PROVIDER=mock
OTP_MOCK_ENABLED=true
# Optional fixed code for the mock provider (dev/test only), e.g. 123456. Leave empty for random codes.
OTP_MOCK_FIXED_CODE=

LOG_LEVEL=debug

# Push notifications. "none" keeps them in the in-app inbox only.
# "expo" also delivers them through Expo's push service (needs an EAS project id in the mobile app).
PUSH_PROVIDER=none

# ===========================================================================
# Third-party providers — PLACEHOLDERS. Fill these in when you have accounts.
# Use sandbox/test keys in development. Never commit real values.
# Nothing below is read by the API yet: each integration is built in
# Phase 4B and will refuse to start in production if its keys are missing.
# ===========================================================================

# --- SMS for login codes (replaces the mock OTP) ---------------------------
# Pick one provider. When it is wired, set OTP_PROVIDER to it and
# OTP_MOCK_ENABLED=false.
# Twilio Verify: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Infobip (alternative): https://portal.infobip.com
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER_ID=

# --- Online payments --------------------------------------------------------
# Paymob (cards, mobile wallets): https://accept.paymob.com  (use test mode keys)
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
# Fawry (alternative): https://atfawry.fawrystaging.com
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=

# --- Maps (server side: geocoding, routes, distances) -----------------------
# Google Maps Platform key restricted to the server's IP and these APIs only.
GOOGLE_MAPS_SERVER_API_KEY=

# --- File storage (profile photos, licence and car documents) ---------------
# Any S3-compatible service (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Push notifications -----------------------------------------------------
# PUSH_PROVIDER=expo turns on delivery (needs EAS_PROJECT_ID in the mobile app).
# Only needed if "enhanced push security" is on for the Expo project:
EXPO_ACCESS_TOKEN=
