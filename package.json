{
  "name": "wasla",
  "private": true,
  "description": "Wasla (وصلة) — carpooling platform for Egypt",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "db:migrate": "pnpm --filter @wasla/api db:migrate",
    "db:seed": "pnpm --filter @wasla/api db:seed",
    "db:reset": "pnpm --filter @wasla/api db:reset",
    "api:dev": "pnpm --filter @wasla/api dev",
    "mobile:dev": "pnpm --filter @wasla/mobile start",
    "mobile:web": "pnpm --filter @wasla/mobile exec expo start --web",
    "admin:dev": "pnpm --filter @wasla/admin dev"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "~5.7.2"
  }
}
