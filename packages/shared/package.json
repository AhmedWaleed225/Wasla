{
  "name": "@wasla/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Validation schemas, enums, design tokens and translations shared by the Wasla API and apps",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  }
}
